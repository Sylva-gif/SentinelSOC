# Local demonstration only. Replace every password/key before any shared deployment.
WEB_PORT=8080
POSTGRES_PASSWORD=local-only-change-me
JWT_SECRET=local-demo-key-change-before-deployment
JWT_EXPIRE_MINUTES=45
RATE_LIMIT_PER_MINUTE=120

# celery enables Redis-backed asynchronous event handling; inline is useful for tests.
ASYNC_MODE=celery

# mock requires no key and is the safe default. Never use secrets committed to this file.
AI_PROVIDER=mock
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional: docker compose --profile observability up, then set OTEL_ENABLED=true.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318/v1/traces